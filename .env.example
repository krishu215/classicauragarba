# Copy these into Vercel: Project > Settings > Environment Variables (or Netlify). Never commit real values.

SITE_URL=https://classicauragarba.vercel.app

# Supabase (project "classic-aura-garba")
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=        # secret: Supabase > Project Settings > API Keys (service_role / secret key)

# Admin dashboard at /admin: comma-separated emails that are allowed in.
# Create each user in Supabase > Authentication > Users (email + password).
ADMIN_EMAILS=

# Razorpay (Dashboard > Account & Settings > API Keys, and Webhooks)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=              # secret
RAZORPAY_WEBHOOK_SECRET=          # secret: the secret you type when creating the webhook

# Email via Resend
RESEND_API_KEY=                   # secret
MAIL_FROM="Classic Aura <noreply@techkrishu.me>"   # the domain must be verified in Resend
ADMIN_NOTIFY_EMAIL=               # where new booking alerts go
